# Optional comma-separated exact browser origins allowed to make cross-origin
# API requests. Same-origin application requests do not need this setting.
# Example: https://your-approved-frontend.example
CORS_ALLOWED_ORIGINS=

# ZionCore 2nd Firebase Admin credential. Keep the actual JSON in Replit Secrets.
# This must belong to zioncore-2nd-production; never use the main project's key.
ZIONCORE_2ND_BOOTSTRAP_SERVICE_ACCOUNT_JSON=

# Checkout stays disabled unless explicitly configured by the operator.
ZIONCORE_CHECKOUT_MODE=disabled
ZIONCORE_LIVE_CHECKOUT_APPROVED=false
ZIONCORE_AUTOMATIC_TAX_ENABLED=false
ZIONCORE_PAID_USAGE_ENABLED=false
ZIONCORE_PREMIUM_FEATURES_ENABLED=false

# Supply these only through the deployment's secret manager; never commit values.
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=

# Optional Stripe reporting mirror. Leave disabled until a reviewed database exists.
ZIONCORE_STRIPE_MIRROR_ENABLED=false
# DATABASE_URL is needed only if the optional Stripe reporting mirror is enabled.
