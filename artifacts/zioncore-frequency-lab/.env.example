# Public Firebase Web app configuration for the independent ZionCore 2nd project.
# These are client configuration values, not service-account credentials.
VITE_ZIONCORE_2ND_FIREBASE_API_KEY=
VITE_ZIONCORE_2ND_FIREBASE_AUTH_DOMAIN=zioncore-2nd-production.firebaseapp.com
VITE_ZIONCORE_2ND_FIREBASE_PROJECT_ID=zioncore-2nd-production
VITE_ZIONCORE_2ND_FIREBASE_APP_ID=1:225578874852:web:df2ab8ae1735860719b9f1
VITE_ZIONCORE_2ND_FIREBASE_MESSAGING_SENDER_ID=225578874852
VITE_ZIONCORE_2ND_FIREBASE_STORAGE_BUCKET=zioncore-2nd-production.firebasestorage.app

# Set true only after Firebase Authentication is initialized for this project.
VITE_ZIONCORE_2ND_FIREBASE_AUTH_SERVER_CONFIGURED=false
VITE_ZIONCORE_2ND_FIREBASE_GOOGLE_AUTH_CONFIGURED=false
VITE_ZIONCORE_2ND_FIREBASE_APPLE_AUTH_CONFIGURED=false

# Public reCAPTCHA Enterprise site key registered for Firebase App Check.
VITE_ZIONCORE_2ND_FIREBASE_APPCHECK_SITE_KEY=

# Development only: optional registered App Check debug token for the dedicated
# development Firebase app. Never configure this in production.
VITE_ZIONCORE_2ND_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Cloud history uses Firebase Authentication and the owner-UID Firestore rules.
# App Check enforcement remains optional while initial functional testing runs.
VITE_ZIONCORE_2ND_FIRESTORE_CLIENT_ACCESS_APPROVED=false

# Keep false until App Check, provider quotas, consent, and cost controls are verified.
VITE_ZIONCORE_2ND_FIREBASE_AI_PROJECT_SECURITY_CONFIRMED=false
